{
  "name": "parenting-bakes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node ./scripts/run-tool.mjs vite --host 0.0.0.0",
    "build": "npm run typecheck && node ./scripts/run-tool.mjs vite build",
    "preview": "node ./scripts/run-tool.mjs vite preview --host 0.0.0.0",
    "test": "node ./scripts/run-tool.mjs vitest run",
    "test:watch": "node ./scripts/run-tool.mjs vitest",
    "typecheck": "node ./scripts/run-tool.mjs tsc --noEmit",
    "assets:audit": "node ./scripts/audit-assets.mjs",
    "deploy": "npm run build && node ./scripts/run-tool.mjs wrangler deploy",
    "deploy:dry": "npm run build && node ./scripts/run-tool.mjs wrangler deploy --dry-run",
    "cf:types": "node ./scripts/run-tool.mjs wrangler types ./src/worker-configuration.d.ts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "qrcode": "1.5.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.2.9",
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@types/node": "^26.1.1",
    "@types/qrcode": "1.5.6",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
