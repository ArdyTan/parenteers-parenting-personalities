{
  "name": "parenting-bakes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node ./scripts/run-tool.mjs vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run assets:share && node ./scripts/run-tool.mjs vite build && npm run prerender:og",
    "build:release": "node ./scripts/check-release-config.mjs && node ./scripts/build-release.mjs",
    "preview": "node ./scripts/run-tool.mjs vite preview --host 0.0.0.0",
    "test": "node ./scripts/run-tool.mjs vitest run",
    "test:watch": "node ./scripts/run-tool.mjs vitest",
    "typecheck": "node ./scripts/run-tool.mjs tsc --noEmit",
    "assets:audit": "node ./scripts/audit-assets.mjs",
    "assets:recolor-backgrounds": "node ./scripts/recolor-image-backgrounds.mjs",
    "assets:normalize-question-art": "node ./scripts/normalize-question-art.mjs",
    "assets:share": "node ./scripts/generate-share-assets.mjs",
    "prerender:og": "node ./scripts/generate-share-assets.mjs --stubs",
    "assets:phase4": "node ./scripts/process-phase4-assets.mjs",
    "assets:stories": "node ./scripts/process-story-illustrations.mjs",
    "assets:preloader": "node ./scripts/process-preloader-video.mjs",
    "assets:pdf": "node ./scripts/generate-pdf-booklets.mjs",
    "assets:pdf-art": "node ./scripts/process-pdf-art.mjs",
    "content:parent-doc": "node ./scripts/sync-parent-content-doc.mjs",
    "qa:phase45": "node ./scripts/qa-phase45.mjs",
    "qa:phase55": "node ./scripts/qa-phase55.mjs",
    "qa:phase9": "node ./scripts/qa-phase9.mjs",
    "qa:pdf": "node ./scripts/qa-pdf.mjs",
    "perf:probe": "node ./scripts/perf-probe.mjs",
    "perf:canvas": "node ./scripts/perf-canvas-audit.mjs",
    "assets:placeholders": "node ./scripts/create-character-placeholders.mjs",
    "deploy": "npm run build:release && node ./scripts/run-tool.mjs wrangler deploy",
    "deploy:dry": "npm run build:release && node ./scripts/run-tool.mjs wrangler deploy --dry-run",
    "cf:types": "node ./scripts/run-tool.mjs wrangler types ./src/worker-configuration.d.ts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.2.9",
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@types/node": "^26.1.1",
    "@types/qrcode": "1.5.6",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
